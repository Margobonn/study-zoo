# Dependencies
node_modules/

# Web build output
dist/

# Capacitor native projects (android/, ios/) ARE committed on purpose —
# that's the official Capacitor guidance, since `npx cap add` does not
# perfectly regenerate manual native customizations. Only their generated
# build artifacts are ignored below.

# Android build artifacts (regenerated by Gradle)
android/app/build/
android/build/
android/.gradle/
android/local.properties
android/captures/
android/**/build/

# iOS build artifacts (regenerated by CocoaPods/Xcode)
ios/App/Pods/
ios/App/build/
ios/App/DerivedData/
ios/App/*.xcworkspace/xcuserdata/
ios/App/*.xcodeproj/xcuserdata/
ios/App/*.xcodeproj/project.xcworkspace/xcuserdata/
ios/App/Podfile.lock.bak

# Secrets — never commit signing material
*.keystore
*.jks
*.p12
*.pem
*.mobileprovision
*.cer
android/keystore.properties
keystore-backup/
.env
.env.local
*.env

# Editor/OS cruft
.DS_Store
Thumbs.db

# Claude Code local dev-server launch config (machine-specific paths)
.claude/

# Verification screenshots taken during development, not app assets
emulator-screenshot*.png
